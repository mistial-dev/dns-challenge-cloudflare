{
    "main": "bin/dns-challenge",
    "output": "dist/dns-challenge.phar",

    "directories": [
        "src",
        "vendor/symfony/console/Resources"
    ],
    "finder": [
        {
            "name": "*.php",
            "exclude": ["test", "tests"],
            "in": "vendor"
         }
    ]
}
